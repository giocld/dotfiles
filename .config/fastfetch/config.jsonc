{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$HOME/.config/fastfetch/logo.txt",
    "color": {
      "1": "#729ebd"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "title": "#729ebd"
    }
  },
  "modules": [
    "title",
     "break",
    {
      "type": "os",
      "key": "os     ",
      "keyColor": "#729ebd" // = color1
    },
    {
      "type": "host",
      "format": "{1}",
      "key": "host   ",
      "keyColor": "#729ebd"
    },
    {
      "type": "packages",
      "format": "{1}",
      "key": "pack   ",
      "keyColor": "#729ebd"
    },
    {
      "type": "cpu",
      "key": "cpu    ",
      "keyColor": "#729ebd"
    },
    {
      "type": "memory",
      "format": "{used} / {total} ({##729ebd}{percentage}{#})",
      "percent": {
        "type": [
          "num"
        ]
      },
      "key": "ram    ",
      "keyColor": "#729ebd"
    },
    {
      "type": "disk",
      "format": "{size-used} / {size-total} ({##729ebd}{size-percentage}{#})",
      "percent": {
        "type": [
          "num"
        ]
      },
      "key": "space  ",
      "keyColor": "#729ebd"
    },
    {
      "type": "battery",
      "format": "{##729ebd}{capacity}{#} ({time-formatted})",
      "percent": {
        "type": [
          "num"
        ]
      },
      "key": "battery",
      "keyColor": "#729ebd"
    }
  ]
}
